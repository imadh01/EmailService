{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EmailService;Trusted_Connection=true;TrustServerCertificate=true;"
  },

  // ── SMTP Settings ───── ───────────────────────────────────────────────
  // Maps to EmailSettings.cs in Configuration/
  "EmailSettings": {
    "EmailHost": "smtp.gmail.com",
    "EmailPort": 587,
    "EmailFrom": "your-email@gmail.com",
    "EmailUserName": "your-email@gmail.com",
    "EmailPassword": "your-app-password-here", // For production: use environment variables or Azure Key Vault.
    "EnableSsl": true,
    "DefaultCredentials": false,
    "EnableEmails": false,
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 100
  },

  // ── Quartz Scheduling ────────────────────────────────────────────────
  // Maps to SchedulingSettings.cs → WorkflowEmailSettings in Configuration/
  "SchedulingSettings": {
    "WorkflowEmail": {
      "Enabled": true,
      "CronExpression": "0 */5 * * * ?",
      "BatchSize": 50
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/email-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
